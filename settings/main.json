{
  ".source.rust": {
    "bracket-matcher": {
      "autocompleteCharacters": ["()", "[]", "{}", "<>", "\"\""],
      "autocompleteDisabledCharacters": ["<"]
    },
    "editor": {
      "commentStart": "// ",
      "commentDelimiters": {
        "line": "//",
        "block": ["/*", "*/"]
      },
      "tabLength": 4,
      "softTabs": true,
      "preferredLineLength": 99
    }
  }
}
